{
  "info": {
    "name": "Campus Canteen - Person 3 API Tests",
    "description": "Run requests in order. Last request requires Member 4 stats route. Auto-generated item names make repeat runs safe.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Database connection ready', () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - List menu",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/menu",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "menu"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Menu is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Add samosa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/menu",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "menu"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{itemName}}\",\n  \"price\": 30,\n  \"category\": \"Snacks\",\n  \"emoji\": \"🥟\",\n  \"image\": \"\",\n  \"available\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('itemName', 'Samosa Test ' + Date.now());",
              "pm.collectionVariables.set('drinkName', 'Lime Juice Test ' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('menuId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
