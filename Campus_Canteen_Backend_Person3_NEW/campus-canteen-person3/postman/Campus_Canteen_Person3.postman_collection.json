    {
      "name": "07 - Place TWO-item order (server total)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": \"Demo Student\",\n  \"items\": [\n    {\n      \"menuId\": \"{{menuId}}\",\n      \"qty\": 2\n    },\n    {\n      \"menuId\": \"{{menuId2}}\",\n      \"qty\": 1\n    }\n  ],\n  \"total\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('orderId', pm.response.json()._id);",
              "pm.test('Server ignored fake total 1 and computed 81', () => pm.expect(pm.response.json().total).to.eql(81));",
              "pm.test('New order is placed', () => pm.expect(pm.response.json().status).to.eql('placed'));"
            ]
          }
        }
      ]
    },
